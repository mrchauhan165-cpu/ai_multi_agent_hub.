<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
          Android 15 (API 35) forces edge-to-edge, so the status and navigation
          bars are transparent and cannot be recoloured any more. Capacitor
          keeps the WebView clear of them (capacitor.config.json ->
          android.adjustMarginsForEdgeToEdge = "auto"), and the strips they
          leave behind show this window background. windowLightStatusBar keeps
          the clock/battery glyphs dark so they stay legible on the white bar.
        -->
        <item name="android:windowBackground">@color/systemBarBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>