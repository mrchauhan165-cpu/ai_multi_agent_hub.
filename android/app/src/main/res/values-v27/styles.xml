<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      API 27+ variant of the runtime theme. A qualified style replaces the
      default one outright, so every item from values/styles.xml is repeated
      here; the only addition is windowLightNavigationBar, which is needed
      because the navigation-bar strip also shows the white window background
      (see values/colors.xml) and would otherwise carry invisible white icons.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/systemBarBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
